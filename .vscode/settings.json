{
    // ============================================
    // LERNPROJEKT: Autovervollstaendigung deaktiviert
    // Der Schueler soll selbst tippen und lernen!
    // Copilot Chat (Tutor) bleibt aktiv.
    // ============================================

    // Copilot Inline-Vorschlaege (grauer Ghost-Text) deaktivieren
    "github.copilot.enable": {
        "*": false,
        "java": false
    },

    // IntelliSense: Nicht automatisch anzeigen beim Tippen
    // Schueler kann mit Ctrl+Space manuell aufrufen wenn noetig
    "editor.quickSuggestions": {
        "other": "off",
        "comments": "off",
        "strings": "off"
    },
    "editor.suggestOnTriggerCharacters": false,
    "editor.parameterHints.enabled": false,
    "editor.wordBasedSuggestions": "off",

    // Automatisches Schliessen von Klammern deaktivieren
    // Schueler muss lernen: jede { braucht eine }
    "editor.autoClosingBrackets": "never",
    "editor.autoClosingQuotes": "never",

    // Snippet-Vorschlaege deaktivieren
    "editor.snippetSuggestions": "none",

    // Auto-Import deaktivieren (Schueler soll import selbst schreiben)
    "java.completion.importOrder": [],
    "editor.codeActionsOnSave": {},

    // ============================================
    // JRE-Quellcode-Navigation deaktivieren
    // Schueler soll nicht in JRE-Sourcecode landen
    // Hover-Tooltips bleiben aktiv (nuetzlich!)
    // ============================================

    // "Go to Definition" auf JRE-Klassen deaktivieren
    "java.referencesCodeLens.enabled": false,
    "java.implementationsCodeLens.enabled": false,

    // Quellcode-Download deaktivieren (verhindert Navigation zu JRE-Sourcen)
    "java.project.sourcePaths": [],
    "java.jdt.ls.lombokSupport.enabled": false,

    // Hover-Tooltips bleiben aktiv (editor.hover.enabled default = true)
    "editor.hover.enabled": "on",
    "window.border": "#FF5733",
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#D32F2F",
        "titleBar.activeForeground": "#FFFFFF"
    }
}
